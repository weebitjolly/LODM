import arcpy
import arcpy  layer = "norfolk_centerlines_random_routes_by_ward"# or full path object_ids = [27,28,29,30]# OIDs of the rows you want  with arcpy.da.SearchCursor(layer, ["OID@", "SHAPE@"]) as cursor:     for oid, geom in cursor:         if oid in object_ids:             length_m = geom.getLength("GEODESIC", "METERS")             ext = geom.extent             print(f"OID {oid}: Length={length_m:.2f} m, "                   f"MinLon={ext.XMin:.6f}, MinLat={ext.YMin:.6f}, "                   f"MaxLon={ext.XMax:.6f}, MaxLat={ext.YMax:.6f}")
